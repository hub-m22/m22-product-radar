# M22 Product Radar — конфигурация через переменные окружения
# Скопируйте в .env и при необходимости измените.
RADAR_DB_PATH=data/radar.sqlite3
RADAR_HOST=127.0.0.1
RADAR_PORT=8022
RADAR_USER_AGENT=M22ProductRadar/0.1 (+https://m22.ru; market research bot)
RADAR_REQUEST_DELAY_SEC=2.0
RADAR_REQUEST_TIMEOUT_SEC=30
RADAR_MAX_RETRIES=3
RADAR_RAW_DIR=data/raw
RADAR_EXPORT_DIR=data/exports
RADAR_BACKUP_DIR=data/backups
RADAR_LOG_LEVEL=INFO
# Планировщик (cron-подобные настройки)
RADAR_SCHEDULE_ENABLED=1
RADAR_COMPETITORS_CRON_HOUR=6
RADAR_M22_CRON_HOUR=5
RADAR_TRENDS_CRON_DOW=mon
RADAR_REPORT_CRON_DOW=mon
# Пороги сигналов
RADAR_PRICE_CHANGE_THRESHOLD_PCT=3
RADAR_MARKET_GAP_THRESHOLD_PCT=10
RADAR_MIN_COMPARABLES=3
RADAR_DEMAND_CHANGE_THRESHOLD_PCT=25
RADAR_ANOMALY_Z=2.5
# Шрифт с кириллицей для PDF (TTF)
RADAR_PDF_FONT_PATH=C:/Windows/Fonts/arial.ttf
# Необязательные интеграции (пусто = источник «требует подключения»)
YANDEX_WORDSTAT_TOKEN=
ANTHROPIC_API_KEY=
